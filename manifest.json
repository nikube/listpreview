{
  "manifest_version": 2,
  "name": "ListPreview",
  "description": "Aperçu du corps du message dans la liste (vue Cartes), façon Outlook/Gmail.",
  "version": "0.3.2",
  "permissions": ["storage"],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "author": "Nicolas Zaoui",
  "browser_specific_settings": {
    "gecko": {
      "id": "listpreview@nikube.dev",
      "strict_min_version": "128.0",
      "strict_max_version": "152.*"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "experiment_apis": {
    "ListPreview": {
      "schema": "api/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["ListPreview"]],
        "script": "api/implementation.js"
      }
    }
  },
  "icons": {
    "64": "icon.svg"
  }
}
